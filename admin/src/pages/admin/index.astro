---
import { getDb } from '../../lib/db';

const db = getDb();
const { rows } = await db.query(
  `SELECT
     p.id, p.title, p.handle, p.featured, p.sort_order, p.images,
     c.name AS category_name,
     (SELECT COALESCE(json_agg(json_build_object(
        'id', v.id, 'title', v.title, 'sku', v.sku, 'price', v.price,
        'currency', v.currency, 'inventory_quantity', v.inventory_quantity
      ) ORDER BY v.title), '[]'::json)
      FROM product_variants v WHERE v.product_id = p.id) AS variants
   FROM products p
   LEFT JOIN categories c ON c.id = p.category_id
   WHERE p.store_id = $1
   ORDER BY p.sort_order ASC, p.title ASC`,
  ['cilmax'],
);
const products = rows;
const { rows: cats } = await db.query(
  `SELECT * FROM categories WHERE store_id = $1 ORDER BY name ASC`,
  ['cilmax'],
);
const categories = cats;
const { rows: themeRows } = await db.query(
  `SELECT primary_color, gold_color FROM store_settings WHERE store_id = $1`,
  ['cilmax'],
);
const theme = themeRows[0] ?? { primary_color: '#008a93', gold_color: '#d4af37' };
const formatMoney = (n: number) => '$' + new Intl.NumberFormat('es-CO').format(n);
---<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel CilMax</title>
    <style is:inline>
      :root {
        --primary: #008a93;
        --primary-hover: #0b6b75;
        --primary-soft: #e3f4f5;
        --gold: #d4af37;
        --bg: #fafafa;
        --surface: #ffffff;
        --text: #111827;
        --muted: #6b7280;
        --border: #e7e9ee;
        --danger: #b91c1c;
        --radius: 10px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      .shell { display: grid; grid-template-columns: 230px 1fr; min-height: 100vh; }
      .sidebar {
        background: var(--primary);
        color: #fff; padding: 20px 16px;
        display: flex; flex-direction: column; gap: 6px;
      }
      .sidebar .brand { font-weight: 800; font-size: 20px; margin-bottom: 18px; }
      .sidebar .brand span { color: var(--gold); }
      .sidebar a {
        color: #e8f6f7; text-decoration: none; padding: 9px 12px;
        border-radius: 8px; font-weight: 600; font-size: 14px;
      }
      .sidebar a:hover { background: rgba(255,255,255,.12); }
      .content { padding: 28px 32px; }
      h1 { margin: 0 0 20px; font-size: 26px; }
      .card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 18px; margin-bottom: 24px;
      }
      .card h2 { margin: 0 0 14px; font-size: 17px; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
      th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
      img.thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 6px; background: var(--primary-soft); }
      .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; }
      .badge.on { background: var(--primary-soft); color: var(--primary-hover); }
      .badge.off { background: #f4f6f8; color: var(--muted); }
      .price { font-weight: 700; }
      a.action { color: var(--primary); font-weight: 600; text-decoration: none; }
      a.action:hover { text-decoration: underline; }
      a.action.danger { color: var(--danger); }
      .btn {
        display: inline-block; border: 0; cursor: pointer; text-decoration: none;
        background: var(--primary); color: #fff; font-weight: 700; font-size: 14px;
        padding: 10px 16px; border-radius: 8px;
      }
      .btn:hover { background: var(--primary-hover); }
      .btn.gold { background: var(--gold); color: #1f1a04; }
      .btn.small { padding: 6px 10px; font-size: 13px; background: var(--primary-soft); color: var(--primary-hover); }
      .btn.small:hover { background: #cfe9ea; }
      .btn.small.danger { background: #fdecec; color: var(--danger); }
      .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      .log {
        font-family: ui-monospace, monospace; font-size: 12px; color: var(--muted);
        white-space: pre-wrap; word-break: break-word;
      }
      .empty { color: var(--muted); font-size: 14px; padding: 12px 0; }
      .pill { display:inline-flex; align-items:center; width:56px; height:28px; position:relative; }
      .pill input { opacity:0; width:0; height:0; }
      .pill .track { width:56px; height:28px; background:#e2e6ec; border-radius:999px; transition:.2s; }
      .pill .track:before { content:''; position:absolute; top:2px; left:2px; width:24px; height:24px; border-radius:50%; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.2); transition:.2s; }
      .pill input:checked + .track { background: var(--primary); }
      .pill input:checked + .track:before { transform: translateX(28px); }
      @media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { flex-direction: row; align-items: center; gap: 12px; overflow-x: auto; }
        .sidebar .brand { margin: 0 8px 0 0; }
        .content { padding: 16px; }
        .grid2 { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="brand">CilMax <span>Admin</span></div>
        <a href="/admin">&gt; Panel principal</a>
        <a href="/admin/producto/nuevo">&gt; Nuevo producto</a>
        <a href="/admin/categorias">&gt; Categorías</a>
        <a href="/admin/colores">&gt; Colores de marca</a>
        <a href="/admin/pedidos">&gt; Pedidos</a>
        <form method="post" action="/api/logout" style="margin-top:auto">
          <button class="btn gold" type="submit" style="background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.3)">Cerrar sesión</button>
        </form>
      </aside>
      <main class="content">
        <div class="topbar">
          <h1>Productos</h1>
          <a class="btn" href="/admin/producto/nuevo">+ Nuevo producto</a>
        </div>
        <div class="card">
          <table>
            <thead>
              <tr>
                <th></th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Destacado</th>
                <th>Orden</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {
                products.length ? products.map((p) => {
                  const first = (p.variants ?? [])[0];
                  const stock = (p.variants ?? []).reduce((s: number, v: any) => s + Number(v.inventory_quantity ?? 0), 0);
                  return (
                    <tr>
                      <td>
                        {p.images?.[0] ? <img class="thumb" src={p.images[0]} alt="" /> : <div class="thumb"></div>}
                      </td>
                      <td><strong>{p.title}</strong><br /><span class="log">/{p.handle}</span></td>
                      <td>{p.category_name ?? <span class="empty">—</span>}</td>
                      <td class="price">{first ? formatMoney(Number(first.price)) : <span class="empty">—</span>}</td>
                      <td>{stock}</td>
                      <td>
                        <span class:list={['badge', p.featured ? 'on' : 'off']}>{p.featured ? 'Sí' : 'No'}</span>
                      </td>
                      <td>{p.sort_order}</td>
                      <td>
                        <a class="action" href={`/admin/producto/${p.handle}`}>Editar</a>
                        {' · '}
                        <form method="post" action="/api/productos" style="display:inline">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="id" value={p.id} />
                          <button class="btn small danger" type="submit" style="border:0;cursor:pointer">Eliminar</button>
                        </form>
                      </td>
                    </tr>
                  );
                }) : (
                  <tr><td colspan="8"><div class="empty">No hay productos todavía.</div></td></tr>
                )
              }
            </tbody>
          </table>
        </div>
        <div class="grid2">
          <div class="card">
            <h2>Categorías ({categories.length})</h2>
            {
              categories.length ? (
                <ul style="margin:0;padding-left:18px;font-size:14px">
                  {categories.map((c) => <li><strong>{c.name}</strong> <span class="log">/{c.slug}</span></li>)}
                </ul>
              ) : <div class="empty">Sin categorías.</div>
            }
            <p style="margin:14px 0 0"><a class="action" href="/admin/categorias">Gestionar categorías →</a></p>
          </div>
          <div class="card">
            <h2>Colores de marca</h2>
            <p style="font-size:14px;margin:0 0 8px">
              Primario: <span style="display:inline-block;width:18px;height:18px;border-radius:4px;vertical-align:middle;background:{theme.primary_color};border:1px solid var(--border)"></span>
              {theme.primary_color}
            </p>
            <p style="font-size:14px;margin:0 0 14px">
              Dorado: <span style="display:inline-block;width:18px;height:18px;border-radius:4px;vertical-align:middle;background:{theme.gold_color};border:1px solid var(--border)"></span>
              {theme.gold_color}
            </p>
            <a class="action" href="/admin/colores">Cambiar colores →</a>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>