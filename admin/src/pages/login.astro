---
const error = (Astro.url.searchParams.get('error') ?? '') === '1';
const blocked = (Astro.url.searchParams.get('error') ?? '') === 'blocked';
const loggedOut = (Astro.url.searchParams.get('out') ?? '') === '1';
---<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso · Panel CilMax</title>
    <style is:inline>
      :root { --primary:#008a93; --primary-hover:#0b6b75; --gold:#d4af37; --text:#111827; --muted:#6b7280; --border:#e7e9ee; }
      * { box-sizing: border-box; }
      body {
        margin:0; min-height:100vh; display:grid; place-items:center;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background:
          radial-gradient(700px 300px at 10% -10%, #e3f4f5 0%, transparent 60%),
          radial-gradient(600px 300px at 110% 110%, #faf3dd 0%, transparent 60%),
          #fafafa;
        color: var(--text);
      }
      .box { width: 100%; max-width: 380px; padding: 36px; background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow: 0 16px 40px rgba(0,107,117,.14); }
      .brand { font-size: 24px; font-weight: 800; margin: 0 0 4px; }
      .brand span { color: var(--gold); }
      .sub { color: var(--muted); font-size: 14px; margin: 0 0 22px; }
      label { display:block; font-size: 13px; font-weight: 700; margin: 0 0 6px; }
      input[type=password] {
        width:100%; padding: 12px 14px; border:1px solid var(--border); border-radius: 10px;
        font-size: 15px; margin-bottom: 16px; outline: none;
      }
      input[type=password]:focus { border-color: var(--primary); box-shadow: 0 0 0 3px #e3f4f5; }
      button {
        width:100%; padding: 13px; border:0; border-radius: 10px; cursor:pointer;
        background: var(--primary); color:#fff; font-size: 15px; font-weight: 800;
      }
      button:hover { background: var(--primary-hover); }
      .msg { font-size: 13px; margin: 0 0 14px; padding: 9px 12px; border-radius: 8px; }
      .msg.err { background:#fdecec; color:#b91c1c; }
      .msg.ok { background:#e8f8ef; color:#137a45; }
      .hint { margin-top: 18px; font-size: 12px; color: var(--muted); text-align:center; }
    </style>
  </head>
  <body>
    <form class="box" method="post" action="/api/login">
      <p class="brand">CilMax <span>Admin</span></p>
      <p class="sub">Panel de administración. Acceso solo para el administrador.</p>
      {error && <p class="msg err">Contraseña incorrecta. Inténtalo de nuevo.</p>}
      {blocked && <p class="msg err">Demasiados intentos. Espera unos minutos antes de volver a intentar.</p>}
      {loggedOut && <p class="msg ok">Sesión cerrada.</p>}
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autofocus autocomplete="current-password" required />
      <button type="submit">Entrar al panel</button>
      <p class="hint">Esta página está separada de la tienda. Nadie más tiene acceso.</p>
    </form>
  </body>
</html>