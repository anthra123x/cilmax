---
import AdminLayout from '../layouts/AdminLayout.astro';
import { getDb } from '../lib/db';

interface Product {
  id: string;
  title: string;
  handle: string;
  description: string | null;
  images: string[];
  tags: string[];
  featured: boolean;
  sort_order: number;
  category_id: number | null;
  variants: Array<{ title: string; sku: string | null; price: number; inventory_quantity: number }>;
}

interface Props {
  title: string;
  heading: string;
  product?: Product;
}

const { title, heading, product } = Astro.props;
const productId = product?.id ?? '';
const db = getDb();
const { rows: categories } = await db.query(
  `SELECT id, slug, name FROM categories WHERE store_id = $1 ORDER BY name ASC`,
  ['cilmax'],
);
---
<AdminLayout title={title}>
  <h1>{heading}</h1>

  <div class="card">
    <form method="post" action="/api/productos" id="product-form">
      {productId && (
        <>
          <input type="hidden" name="_action" value="update" />
          <input type="hidden" name="id" value={productId} />
        </>
      )}
      <input type="hidden" name="handle" value={product?.handle ?? ''} />

      <section class="field">
        <h2 class="section-title">Información básica</h2>
        <div class="field">
          <label for="title">Nombre del producto *</label>
          <input id="title" name="title" type="text" required value={product?.title} placeholder="Ej. Auriculares inalámbricos" />
        </div>

        <div class="row">
          <div class="field">
            <label for="category_id">Categoría</label>
            <select id="category_id" name="category_id">
              <option value="">— Sin categoría —</option>
              {categories.map((c) => (
                <option value={c.id} selected={String(product?.category_id) === String(c.id)}>{c.name}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="order">Orden en el catálogo</label>
            <input id="order" name="order" type="number" value={product?.sort_order ?? 100} />
          </div>
          <div class="field" style="display:flex;align-items:flex-end">
            <label class="switch" for="featured">
              <input id="featured" name="featured" type="checkbox" checked={product?.featured} />
              Destacado en portada
            </label>
          </div>
        </div>

        <div class="field">
          <label for="description">Descripción</label>
          <textarea id="description" name="description" rows="4" placeholder="Describe el producto…">{product?.description}</textarea>
        </div>
      </section>

      <section class="field section">
        <h2 class="section-title">Imágenes</h2>
        <div class="row" style="align-items:center">
          <input id="file-input" type="file" accept="image/*" multiple />
          <button id="upload-btn" class="btn" type="button">Subir imágenes</button>
          <span id="upload-status" class="help" role="status" aria-live="polite"></span>
        </div>
        <p class="help">Selecciona las fotos desde tu computador. También puedes pegar enlaces en el campo de abajo (una por línea).</p>
        <div class="field" style="margin-top:8px">
          <label for="images">Enlaces de imagen (opcional)</label>
          <textarea id="images" name="images" class="code" rows="3">{product?.images.join('\n')}</textarea>
        </div>
        <div id="image-preview" class="image-preview" aria-label="Vista previa de las imágenes"></div>
      </section>

      <section class="field section">
        <h2 class="section-title">Variantes</h2>
        <p class="help">Cada variante es un color/tamaño distinto del producto. Completa los campos de cada una.</p>
        <div id="variants-container">
          {product && product.variants.length > 0 ? (
            product.variants.map((v, i) => (
              <div class="variant-row" data-variant-row>
                <div class="variant-grid">
                  <div class="field">
                    <label>Nombre</label>
                    <input type="text" name="vtitle[]" value={v.title} placeholder="Ej. Negro" required />
                  </div>
                  <div class="field">
                    <label>SKU</label>
                    <input type="text" name="vsku[]" value={v.sku ?? ''} placeholder="Ej. AU-001-BLK" />
                  </div>
                  <div class="field">
                    <label>Precio (COP) *</label>
                    <input type="number" name="vprice[]" value={v.price} placeholder="Ej. 549900" required />
                  </div>
                  <div class="field">
                    <label>Stock</label>
                    <input type="number" name="vstock[]" value={v.inventory_quantity} placeholder="Ej. 12" />
                  </div>
                  <button type="button" class="btn ghost variant-remove" aria-label="Quitar variante">✕</button>
                </div>
              </div>
            ))
          ) : (
            <div class="variant-row" data-variant-row>
              <div class="variant-grid">
                <div class="field">
                  <label>Nombre</label>
                  <input type="text" name="vtitle[]" placeholder="Ej. Negro" required />
                </div>
                <div class="field">
                  <label>SKU</label>
                  <input type="text" name="vsku[]" placeholder="Ej. AU-001-BLK" />
                </div>
                <div class="field">
                  <label>Precio (COP) *</label>
                  <input type="number" name="vprice[]" placeholder="Ej. 549900" required />
                </div>
                <div class="field">
                  <label>Stock</label>
                  <input type="number" name="vstock[]" placeholder="Ej. 12" />
                </div>
                <button type="button" class="btn ghost variant-remove" aria-label="Quitar variante">✕</button>
              </div>
            </div>
          )}
        </div>
        <button type="button" class="btn ghost" id="add-variant">+ Añadir variante</button>
      </section>

      <section class="field section">
        <h2 class="section-title">Etiquetas</h2>
        <p class="help">Separadas por coma. Ayudan a clasificar el producto.</p>
        <input id="tags" name="tags" type="text" value={product?.tags.join(', ')} placeholder="Ej. audio, inalámbrico" />
      </section>

      <button class="btn" type="submit">{productId ? 'Guardar cambios' : 'Crear producto'}</button>

      {productId && (
        <span style="margin-left:12px">
          <form method="post" action="/api/productos" style="display:inline">
            <input type="hidden" name="_action" value="delete" />
            <input type="hidden" name="id" value={productId} />
            <button class="btn danger" type="submit">Eliminar producto</button>
          </form>
        </span>
      )}
    </form>
  </div>

  {product && (
    <div class="card">
      <h2>Vista previa en la tienda</h2>
      <p style="margin:0">
        <a href={`${import.meta.env.SITE ?? 'https://cilmax.vercel.app'}/producto/${product.handle}`} target="_blank" class="action">
          /producto/{product.handle}
        </a>
      </p>
    </div>
  )}

  <script>
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const btn = document.getElementById('upload-btn') as HTMLButtonElement | null;
    const status = document.getElementById('upload-status') as HTMLSpanElement | null;
    const images = document.getElementById('images') as HTMLTextAreaElement | null;
    const preview = document.getElementById('image-preview') as HTMLDivElement | null;

    function renderPreview() {
      if (!preview || !images) return;
      const urls = images.value.split('\n').map((s) => s.trim()).filter(Boolean);
      preview.innerHTML = '';
      for (const url of urls) {
        const wrap = document.createElement('div');
        wrap.className = 'thumb';
        const img = document.createElement('img');
        img.src = url;
        img.alt = 'Imagen del producto';
        img.loading = 'lazy';
        img.onerror = () => { wrap.classList.add('broken'); wrap.title = 'No se pudo cargar la imagen'; };
        const rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'thumb-remove';
        rm.textContent = '✕';
        rm.title = 'Quitar esta imagen';
        rm.addEventListener('click', () => {
          const rest = images.value.split('\n').map((s) => s.trim()).filter((s) => s && s !== url);
          images.value = rest.join('\n');
          renderPreview();
        });
        wrap.append(img, rm);
        preview.append(wrap);
      }
    }

    if (fileInput && btn && status && images && preview) {
      renderPreview();

      btn.addEventListener('click', async () => {
        const files = fileInput.files;
        if (!files || files.length === 0) {
          status.textContent = 'Selecciona una o más imágenes primero.';
          return;
        }
        const form = new FormData();
        for (const f of files) form.append('files', f);
        btn.disabled = true;
        status.textContent = 'Subiendo…';
        try {
          const res = await fetch('/api/images', {
            method: 'POST',
            body: form,
            headers: { Origin: window.location.origin },
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Error al subir');
          const existing = images.value.trim();
          const added = (data.urls as string[]).filter(Boolean);
          images.value = existing ? existing + '\n' + added.join('\n') : added.join('\n');
          status.textContent = added.length > 0 ? `Se subieron ${added.length} imagen(es).` : 'No se subió ninguna imagen.';
          fileInput.value = '';
          renderPreview();
        } catch (err) {
          status.textContent = err instanceof Error ? err.message : 'Error al subir la imagen.';
        } finally {
          btn.disabled = false;
        }
      });
    }

    const variantContainer = document.getElementById('variants-container');
    const addVariantBtn = document.getElementById('add-variant');
    const form = document.getElementById('product-form');

    function makeVariantRow() {
      const row = document.createElement('div');
      row.className = 'variant-row';
      row.innerHTML = `
        <div class="variant-grid">
          <div class="field"><label>Nombre</label><input type="text" name="vtitle[]" placeholder="Ej. Negro" required /></div>
          <div class="field"><label>SKU</label><input type="text" name="vsku[]" placeholder="Ej. AU-001-BLK" /></div>
          <div class="field"><label>Precio (COP) *</label><input type="number" name="vprice[]" placeholder="Ej. 549900" required /></div>
          <div class="field"><label>Stock</label><input type="number" name="vstock[]" placeholder="Ej. 12" /></div>
          <button type="button" class="btn ghost variant-remove" aria-label="Quitar variante">✕</button>
        </div>`;
      row.querySelector('.variant-remove')!.addEventListener('click', () => row.remove());
      return row;
    }

    if (variantContainer && addVariantBtn) {
      addVariantBtn.addEventListener('click', () => {
        variantContainer.append(makeVariantRow());
      });
      variantContainer.querySelectorAll<HTMLButtonElement>('.variant-remove').forEach((b) => {
        b.addEventListener('click', () => b.closest('.variant-row')?.remove());
      });
    }

    if (form) {
      form.addEventListener('submit', () => {
        const rows = variantContainer?.querySelectorAll<HTMLDivElement>('.variant-row') ?? [];
        rows.forEach((row) => {
          const title = row.querySelector<HTMLInputElement>('input[name="vtitle[]"]')?.value.trim() ?? '';
          if (!title) row.remove();
        });
      });
    }
  </script>
</AdminLayout>
