# ============================================================
# Variables de entorno — CilMax Storefront (Astro)
# Copia este archivo a `.env` y rellena los valores reales.
# En Vercel, define estas mismas variables en Settings → Environment.
# ============================================================

# URL pública del backend de Medusa (la API Store).
# Local: http://localhost:9000
# Producción: https://tu-medusa-backend.example.com
PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Clave publicable ("publishable API key") que creas en el admin de Medusa
# (Settings → Developer → Publishable API Keys). Asocia la venta a tu
# sales channel. Es de uso cliente por diseño (solo habilita la Store API).
PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxx

# País/región por defecto para precios y envíos (código ISO-2).
# CilMax es una tienda colombiana: moneda COP y país CO.
# Se usa para aplicar impuestos del region correcto en las consultas.
PUBLIC_DEFAULT_COUNTRY=co

# (Opcional) URL pública de Vercel, para rutas canónicas:
# PUBLIC_BASE_URL=https://cilmax-tienda.vercel.app

# Número de WhatsApp para pedidos y atención (formato internacional, sin "+").
# Real: +57 315 4804781 -> 573154804781
PUBLIC_WHATSAPP_NUMBER=573154804781

# ============================================================
# Backend (Neon Postgres) — privado, NO usar PUBLIC_* (evita exponerlo al cliente)
# ============================================================

# Cadena de conexión del cluster Neon (pooler). Cópiala desde tu dashboard Neon.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST-pooler.c-REGION.aws.neon.tech/DB?sslmode=require

# Clave para endpoints de administracion/consulta (header x-admin-key). Inventa
# una larga y aleatoria; el storefront PUBLICO no la necesita.
ADMIN_KEY=genera-una-clave-aleatoria-larga
