---
// Header / Barra de navegación global.
// El botón del carrito es un island (client:visible) que muestra el contador
// y abre el drawer. En fases posteriores se conecta búsqueda y menú móvil.

import CartButton from './cart/CartButton.tsx';
import SearchBar from './search/SearchBar.tsx';
import { whatsappLink } from '../lib/site';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/tiendas', label: 'Tiendas' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label="CilMax — Inicio">
      Cil<span>Max</span>
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <ul class="header__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <SearchBar client:load />
      <a
        class="header__whatsapp"
        href={whatsappLink('Hola CilMax, quiero hacer un pedido.')}
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
        </svg>
        Pedir por WhatsApp
      </a>
      <CartButton client:visible />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    background-color: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header__logo {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .header__logo::after {
    content: '';
    width: 7px;
    height: 7px;
    margin-left: 3px;
    border-radius: 50%;
    background-color: var(--color-gold);
  }

  .header__logo span {
    color: var(--color-primary);
  }

  .header__nav {
    margin-inline: auto;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
  }

  .header__links a {
    position: relative;
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .header__links a:hover {
    color: var(--color-primary);
  }

  .header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .header__links a:hover::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-whatsapp);
    color: #ffffff;
    font-size: var(--font-size-sm);
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.12s ease;
  }

  .header__whatsapp:hover {
    background-color: var(--color-primary-hover);
    box-shadow: 0 6px 16px rgba(212, 175, 55, 0.3);
  }

  .header__whatsapp:hover svg {
    color: var(--color-gold-bright);
  }

  .header__whatsapp:active {
    transform: scale(0.97);
  }

  .header__whatsapp svg {
    width: 16px;
    height: 16px;
  }

  /* Tablet y móvil: colapsar la navegación.
     En <= 768px el nav horizontal y el botón del carrito se ocultan,
     porque la navegación y el acceso al carrito viven en la barra inferior
     (BottomNav). El header queda limpio con solo el logo. */
  @media (max-width: 768px) {
    .header__nav {
      display: none;
    }

    .header__actions {
      display: none;
    }
  }
</style>
