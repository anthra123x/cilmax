---
// Tarjeta de producto para el catálogo (vitrina).
// Recibe un producto normalizado (ProductData) procedente de Medusa o del
// fallback local, y muestra la primera variante con su precio real.
// El CTA principal es directo a WhatsApp: consulta y pedido sin fricciones.

import type { ProductData } from '../lib/medusa';
import { formatPrice } from '../lib/medusa';
import { whatsappLink } from '../lib/site';

interface Props {
  product: ProductData;
}

const { product } = Astro.props;

const defaultVariant = product.variants[0];
const priceLabel = defaultVariant
  ? formatPrice(defaultVariant.amount, defaultVariant.currencyCode)
  : null;
const image = product.images[0]?.url ?? product.thumbnail;
const message = `Hola CilMax,\nQuiero pedir: ${product.title}${priceLabel ? ` (${priceLabel})` : ''}\nQuedo atento a la confirmación.`;
const featured = product.featured;
---

<article class="product-card">
  <a class="product-card__link" href={`/producto/${product.handle}`}>
    <div class="product-card__media">
      {
        image ? (
          <img src={image} alt={product.title} loading="lazy" />
        ) : (
          <div class="product-card__placeholder" aria-hidden="true">
            <span>{product.title.slice(0, 1)}</span>
          </div>
        )
      }
      {
        featured && (
          <span class="product-card__badge">Destacado</span>
        )
      }
    </div>
    <div class="product-card__body">
      {
        product.collectionTitle && (
          <span class="product-card__collection">{product.collectionTitle}</span>
        )
      }
      <h3 class="product-card__title">{product.title}</h3>
      <p class="product-card__price">{priceLabel}</p>
    </div>
  </a>

  <a
    class="product-card__cta"
    href={whatsappLink(message)}
    target="_blank"
    rel="noopener"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
    </svg>
    Pedir por WhatsApp
  </a>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .product-card:hover {
    box-shadow: 0 10px 26px rgba(0, 107, 117, 0.12), 0 0 0 1px rgba(212, 175, 55, 0.22);
    transform: translateY(-3px);
    border-color: rgba(212, 175, 55, 0.5);
  }

  .product-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-muted);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-4xl);
    font-weight: 700;
    color: var(--color-border);
    user-select: none;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: var(--space-4) var(--space-4) var(--space-3);
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 2;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--color-gold-hover), var(--color-gold));
    color: #1f1a04;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.35);
  }

  .product-card__collection {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .product-card__title {
    font-size: var(--font-size-base);
    font-weight: 650;
    line-height: 1.3;
    color: var(--color-text);
  }

  .product-card__price {
    font-size: var(--font-size-base);
    font-weight: 750;
    color: var(--color-primary);
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 var(--space-4) var(--space-4);
    padding: 0.625rem 1rem;
    border-radius: var(--radius-md);
    background-color: var(--color-whatsapp);
    color: #ffffff;
    font-size: var(--font-size-sm);
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.12s ease;
  }

  .product-card__cta svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .product-card__cta:hover {
    background-color: var(--color-primary-hover);
    box-shadow: 0 6px 16px rgba(212, 175, 55, 0.3);
  }

  .product-card__cta:hover svg {
    color: var(--color-gold-bright);
  }

  .product-card__cta:active {
    transform: scale(0.98);
  }
</style>