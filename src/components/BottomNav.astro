---
// Barra de navegación inferior para móvil/tablet.
// Solo se muestra en pantallas pequeñas (<= 768px, vía CSS). En desktop el
// nav horizontal del Header sigue siendo la navegación principal.
// El único elemento reactivo es el badge del carrito (island CartBadge).

import CartBadge from './cart/CartBadge.tsx';

const pathname = Astro.url.pathname;

const items = [
  {
    href: '/',
    label: 'Inicio',
    icon: 'home',
  },
  {
    href: '/catalogo',
    label: 'Catálogo',
    icon: 'catalogo',
  },
  {
    href: '/tiendas',
    label: 'Tiendas',
    icon: 'tiendas',
  },
  {
    href: '/contacto',
    label: 'Contacto',
    icon: 'contacto',
  },
];
---

<nav class="bottom-nav" aria-label="Navegación móvil">
  <ul class="bottom-nav__list">
    {
      items.map((item) => {
        const active =
          item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
        return (
          <li class="bottom-nav__item">
            <a
              class={`bottom-nav__link${active ? ' bottom-nav__link--active' : ''}`}
              href={item.href}
              aria-current={active ? 'page' : undefined}
            >
              <span class="bottom-nav__icon" aria-hidden="true">
                {
                  item.icon === 'home' ? (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 10.5 12 3l9 7.5" />
                      <path d="M5 9.5V21h14V9.5" />
                      <path d="M10 21v-6h4v6" />
                    </svg>
                  ) : item.icon === 'catalogo' ? (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="7" height="7" rx="1.5" />
                      <rect x="14" y="3" width="7" height="7" rx="1.5" />
                      <rect x="3" y="14" width="7" height="7" rx="1.5" />
                      <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                  ) : item.icon === 'tiendas' ? (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 10v10h16V10" />
                      <path d="M3 4h18l-1 6a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0Z" />
                      <path d="M9 20v-5h6v5" />
                    </svg>
                  ) : (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 1 1 16.1-3.8Z" />
                    </svg>
                  )
                }
              </span>
              <span class="bottom-nav__label">{item.label}</span>
            </a>
          </li>
        );
      })
    }

    <li class="bottom-nav__item">
      <a
        class={`bottom-nav__link${pathname.startsWith('/carrito') ? ' bottom-nav__link--active' : ''}`}
        href="/carrito"
        aria-current={pathname.startsWith('/carrito') ? 'page' : undefined}
      >
        <span class="bottom-nav__icon bottom-nav__icon--cart" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
        </span>
        <span class="bottom-nav__label">Carrito</span>
        <CartBadge client:visible />
      </a>
    </li>
  </ul>
</nav>
