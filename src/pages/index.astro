---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/medusa';

export const prerender = true;
export const revalidate = 300;

const allProducts = await getProducts(24);
const featured = allProducts.filter((p) => p.featured);
const products = (featured.length > 0 ? featured : allProducts).slice(0, 6);
---

<Layout title="CilMax — Tu tienda online">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Nuevos productos cada semana</p>
      <h1 class="hero__title">Todo lo que necesitas, en un solo lugar</h1>
      <p class="hero__subtitle">
        Descubre tecnología, hogar y accesorios seleccionados con calidad.
        Envío en Colombia y atención cercana.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/catalogo">Ver catálogo</a>
        <a class="btn btn--ghost" href="/contacto">Contáctanos</a>
      </div>
    </div>
  </section>

  <!-- Zona del catálogo -->
  <section class="catalog" aria-labelledby="catalog-title">
    <div class="container">
      <div class="catalog__header">
        <h2 id="catalog-title">Productos destacados</h2>
      </div>

      <div class="catalog__grid">
        {
          products.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: var(--space-24) var(--space-16);
    background: linear-gradient(
      180deg,
      var(--color-accent-soft),
      var(--color-bg) 70%
    );
  }

  .hero__inner {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .hero__eyebrow {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: var(--font-size-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
  }

  .hero__subtitle {
    margin-top: var(--space-4);
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }

  .hero__actions {
    margin-top: var(--space-6);
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: var(--font-size-3xl);
    }
  }

  /* ---- Catálogo ---- */
  .catalog {
    padding-block: var(--space-16);
  }

  .catalog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
  }

  .catalog__header h2 {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
