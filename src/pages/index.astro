---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/medusa';

export const prerender = true;
export const revalidate = 300;

const allProducts = await getProducts(24);
const featured = allProducts.filter((p) => p.featured);
const products = (featured.length > 0 ? featured : allProducts).slice(0, 6);
---

<Layout title="CilMax — Tu tienda online">
  <!-- Hero compacto -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Nuevos productos cada semana</p>
      <h1 class="hero__title">Todo lo que necesitas, en un solo lugar</h1>
      <p class="hero__subtitle">
        Tecnología, hogar y accesorios con calidad. Cotiza y pide por WhatsApp,
        con atención cercana.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/catalogo">
          Ver catálogo
          <svg
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a class="btn btn--ghost" href="/contacto">Contáctanos</a>
      </div>
    </div>
  </section>

  <!-- Franja de confianza -->
  <section class="service-strip" aria-label="Ventajas de comprar en CilMax">
    <div class="container service-strip__inner">
      <div class="service-strip__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 18V6a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1" />
          <path d="M14 9h4l3 3v5a1 1 0 0 1-1 1h-1" />
          <circle cx="7" cy="18" r="2" />
          <circle cx="17" cy="18" r="2" />
        </svg>
        <div>
          <strong>Envíos en Colombia</strong>
          <span>Entrega coordinada por WhatsApp</span>
        </div>
      </div>
      <div class="service-strip__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
        <div>
          <strong>Atención cercana</strong>
          <span>Respondemos tus dudas al instante</span>
        </div>
      </div>
      <div class="service-strip__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
          <path d="M3 6h18" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <div>
          <strong>Pedido directo</strong>
          <span>Cotiza desde cada producto por WhatsApp</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Vitrina de productos -->
  <section class="catalog" aria-labelledby="catalog-title">
    <div class="container">
      <div class="catalog__header">
        <h2 id="catalog-title">Productos destacados</h2>
        <a class="catalog__link" href="/catalogo">
          Ver catálogo completo
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="catalog__grid">
        {
          products.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero compacto ---- */
  .hero {
    padding-block: var(--space-16) var(--space-12);
    background: linear-gradient(180deg, #edf3f5, var(--color-bg) 72%);
  }

  .hero__inner {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .hero__eyebrow {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-primary);
  }

  .hero__title {
    margin-top: var(--space-3);
    font-size: var(--font-size-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-text);
  }

  .hero__subtitle {
    margin-top: var(--space-4);
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    max-width: 54ch;
    margin-inline: auto;
  }

  .hero__actions {
    margin-top: var(--space-6);
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero__actions .btn--primary svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-12) var(--space-8);
    }

    .hero__title {
      font-size: 1.875rem;
    }
  }

  /* ---- Franja de confianza ---- */
  .service-strip {
    border-block: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .service-strip__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .service-strip__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4);
  }

  .service-strip__item + .service-strip__item {
    border-left: 1px solid var(--color-border);
  }

  .service-strip__item svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .service-strip__item strong {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 650;
    color: var(--color-text);
  }

  .service-strip__item span {
    display: block;
    margin-top: 2px;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .service-strip__inner {
      grid-template-columns: 1fr;
    }

    .service-strip__item + .service-strip__item {
      border-left: none;
      border-top: 1px solid var(--color-border);
    }
  }

  /* ---- Vitrina de productos ---- */
  .catalog {
    padding-block: var(--space-12) var(--space-16);
  }

  .catalog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .catalog__header h2 {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .catalog__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
    transition: gap 0.2s ease;
  }

  .catalog__link svg {
    width: 16px;
    height: 16px;
  }

  .catalog__link:hover {
    gap: 10px;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>