---
// Página de catálogo. Se renderiza en cada petición (SSR) leyendo los
// productos desde la base de datos, para que los cambios del panel de
// administración se reflejen de forma inmediata.

import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, getCategories } from '../lib/medusa';

const catRaw = Astro.url.searchParams.get('categoria');
const categoryId = catRaw && /^\d+$/.test(catRaw) ? Number(catRaw) : null;
const [products, categories] = await Promise.all([
  getProducts(24, 0, { categoryId }),
  getCategories(),
]);
const activeCategory = categories.find((c) => c.id === categoryId) ?? null;
---

<Layout title="Catálogo — CilMax">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Catálogo</h1>
      <p class="page-hero__subtitle">
        Todos nuestros productos en un solo lugar. Actualizado con las
        últimas novedades.
      </p>
    </div>
  </section>

  <section class="catalog" aria-labelledby="catalog-title">
    <div class="container">
      <div class="catalog__header">
        <h2 id="catalog-title">
          {activeCategory ? activeCategory.name : `${products.length} productos`}
        </h2>
      </div>

      <div class="catalog__chips" role="group" aria-label="Filtrar por categoría">
        <a
          class={`catalog__chip${categoryId === null ? ' catalog__chip--active' : ''}`}
          href="/catalogo"
          aria-current={categoryId === null ? 'page' : undefined}
        >
          Todos
        </a>
        {categories.map((c) => {
          const active = c.id === categoryId;
          return (
            <a
              class={`catalog__chip${active ? ' catalog__chip--active' : ''}`}
              href={`/catalogo?categoria=${c.id}`}
              aria-current={active ? 'page' : undefined}
            >
              {c.name}
            </a>
          );
        })}
      </div>

      {
        products.length > 0 ? (
          <div class="catalog__grid">
            {products.map((product) => <ProductCard product={product} />)}
          </div>
        ) : (
          <p class="catalog__empty">
            {activeCategory
              ? 'No hay productos en esta categoría por ahora.'
              : 'No hay productos disponibles por ahora.'}
          </p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: var(--space-12) var(--space-8);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 70%);
  }

  .page-hero__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .page-hero__subtitle {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .catalog {
    padding-block: var(--space-8) var(--space-16);
  }

  .catalog__header {
    margin-bottom: var(--space-6);
  }

  .catalog__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .catalog__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .catalog__chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .catalog__chip--active {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .catalog__header h2 {
    font-size: var(--font-size-xl);
    font-weight: 700;
  }

  .catalog__empty {
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 1024px) {
    .catalog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
