---
// Página de contacto de CilMax (tienda colombiana).
// Muestra canales de atención y un formulario de contacto. El formulario envía
// el mensaje a /api/contacto, que lo guarda para verse en el panel de admin.

import Layout from '../layouts/Layout.astro';

const contactChannels = [
  {
    title: 'Dirección',
    lines: ['Calle 10a #24-03, barrio Bolívar', 'Bucaramanga, Colombia'],
  },
  {
    title: 'Teléfono',
    lines: ['+57 315 480 4781'],
  },
  {
    title: 'Correo',
    lines: ['hola@cilmax.co', 'ventas@cilmax.co'],
  },
  {
    title: 'Horario de atención',
    lines: ['Lunes a viernes: 8:00 a. m. – 6:00 p. m.', 'Sábados: 9:00 a. m. – 2:00 p. m.'],
  },
];
---

<Layout
  title="Contacto — CilMax"
  description="Contáctanos: dudas, soporte, pedidos y asesoría. Atención al cliente CilMax en Colombia."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Contacto</h1>
      <p class="page-hero__subtitle">
        Estamos aquí para ayudarte. Escríbenos o llámanos y te respondemos lo
        antes posible.
      </p>
    </div>
  </section>

  <section class="contact container">
    <div class="contact__grid">
      <div class="contact__channels">
        {
          contactChannels.map((channel) => (
            <div class="channel">
              <span class="channel__icon" aria-hidden="true">
                <svg
                  width="22" height="22" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 3" />
                </svg>
              </span>
              <div>
                <h3 class="channel__title">{channel.title}</h3>
                {channel.lines.map((line) => <p class="channel__line">{line}</p>)}
              </div>
            </div>
          ))
        }
      </div>

      <form class="contact-form" id="contact-form">
        <h2 class="contact-form__title">Envíanos un mensaje</h2>
        <div class="contact-form__row">
          <label class="field">
            <span class="field__label">Nombre</span>
            <input class="field__input" type="text" name="nombre" required placeholder="Tu nombre" />
          </label>
          <label class="field">
            <span class="field__label">Correo</span>
            <input class="field__input" type="email" name="correo" required placeholder="tucorreo@ejemplo.com" />
          </label>
        </div>
        <label class="field">
          <span class="field__label">Asunto</span>
          <input class="field__input" type="text" name="asunto" placeholder="¿En qué te ayudamos?" />
        </label>
        <label class="field">
          <span class="field__label">Mensaje</span>
          <textarea class="field__input field__textarea" name="mensaje" rows="5" required placeholder="Escribe tu mensaje..."></textarea>
        </label>
        <button class="btn btn--primary contact-form__submit" type="submit">
          Enviar mensaje
        </button>
        <p class="contact-form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.querySelector('.contact-form__status') as HTMLElement | null;
  const submitBtn = document.querySelector('.contact-form__submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status || !submitBtn) return;

    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    const correo = String(data.get('correo') ?? '').trim();
    const asunto = String(data.get('asunto') ?? '').trim();
    const mensaje = String(data.get('mensaje') ?? '').trim();

    status.textContent = 'Enviando…';
    status.style.color = 'var(--color-text-muted)';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Origin: window.location.origin },
        body: JSON.stringify({ nombre, correo, asunto, mensaje }),
      });
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(payload?.error || 'No se pudo enviar el mensaje.');

      status.textContent = '¡Gracias! Tu mensaje fue enviado correctamente.';
      status.style.color = 'var(--color-primary)';
      form.reset();
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : 'No se pudo enviar el mensaje.';
      status.style.color = '#b91c1c';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .page-hero {
    padding-block: var(--space-12) var(--space-8);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 70%);
  }

  .page-hero__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .page-hero__subtitle {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .contact {
    padding-block: var(--space-8) var(--space-16);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-12);
    align-items: start;
  }

  .contact__channels {
    display: grid;
    gap: var(--space-4);
  }

  .channel {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .channel__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .channel__title {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .channel__line {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .contact-form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .contact-form__title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field__label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .field__input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-base);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .field__textarea {
    resize: vertical;
  }

  .contact-form__submit {
    justify-self: start;
    margin-top: var(--space-2);
  }

  .contact-form__status {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
  }

  @media (max-width: 820px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
