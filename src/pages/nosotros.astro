---
// Página "Sobre nosotros" de CilMax.
// Presenta la marca, el local físico y un CTA al catálogo / WhatsApp.

import Layout from '../layouts/Layout.astro';
import { storeInfo, whatsappLink } from '../lib/site';

const values = [
  {
    title: 'Calidad',
    text: 'Seleccionamos productos confiables y duraderos para tu hogar u oficina.',
  },
  {
    title: 'Atención cercana',
    text: 'Te asesoramos por WhatsApp y respondemos tus dudas en persona en nuestra tienda.',
  },
  {
    title: 'Envíos a todo el país',
    text: 'Hacemos entregas a toda Colombia con seguimiento de tu pedido.',
  },
];
---

<Layout
  title="Sobre nosotros — CilMax"
  description="Conoce a CilMax: nuestra tienda física en Bucaramanga, misión, valores y cómo trabajamos."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Sobre nosotros</h1>
      <p class="page-hero__subtitle">
        {storeInfo.tagline}
      </p>
    </div>
  </section>

  <section class="about container">
    <div class="about__intro">
      <h2>Quiénes somos</h2>
      <p>
        CilMax es una tienda colombiana dedicada a ofrecer productos de calidad
        para tu hogar y tu oficina: tecnología, accesorios, mobiliario y más.
        Creemos en la atención cercana, la confianza y el acompañamiento en cada
        compra, desde el primer contacto hasta la entrega.
      </p>
      <p>
        Atendemos en nuestra tienda física en Bucaramanga y vendemos en línea con
        envíos a todo el país.
      </p>
    </div>

    <div class="about__values">
      {values.map((value) => (
        <article class="value-card">
          <h3>{value.title}</h3>
          <p>{value.text}</p>
        </article>
      ))}
    </div>

    <div class="about__cta">
      <h3>¿Hablamos?</h3>
      <p>
        Escríbenos por WhatsApp o visítanos. Con gusto te asesoramos y te
        ayudamos a encontrar lo que necesitas.
      </p>
      <a class="btn btn--primary" href={whatsappLink('Hola CilMax, quiero más información.')} target="_blank" rel="noopener">
        Escríbenos por WhatsApp
      </a>
      <a class="btn btn--secondary" href="/catalogo">Ver catálogo</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: var(--space-12) var(--space-8);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 70%);
  }

  .page-hero__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .page-hero__subtitle {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .about {
    padding-block: var(--space-8) var(--space-16);
    display: grid;
    gap: var(--space-12);
  }

  .about__intro {
    max-width: 70ch;
    display: grid;
    gap: var(--space-4);
  }

  .about__intro h2 {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .about__intro p {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .about__values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .value-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-gold);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .value-card h3 {
    font-size: var(--font-size-lg);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .value-card p {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .about__cta {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 80%);
  }

  .about__cta h3 {
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-text);
  }

  .about__cta p {
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .about__cta .btn + .btn {
    margin-top: var(--space-1);
  }

  @media (max-width: 768px) {
    .about__values {
      grid-template-columns: 1fr;
    }
  }
</style>
