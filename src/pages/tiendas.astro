---
// Página "Tiendas" de CilMax. Muestra las tiendas físicas disponibles y
// enlaza la atención/pedidos por WhatsApp. De momento hay una sola sede.

import Layout from '../layouts/Layout.astro';
import { stores, whatsappLink } from '../lib/site';
---

<Layout
  title="Tiendas — CilMax"
  description="Nuestras tiendas físicas. Encuentra la tienda CilMax más cercana y contáctanos por WhatsApp."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Nuestras tiendas</h1>
      <p class="page-hero__subtitle">
        Visítanos en persona o pide por WhatsApp. Te atendemos con gusto en
        toda Colombia.
      </p>
    </div>
  </section>

  <section class="stores container">
    <div class="stores__grid">
      {
        stores.map((store) => {
          const msg = `Hola CilMax, quiero más información de la tienda ${store.name} (${store.city}).`;
          return (
            <article class="store-card">
              <span class="store-card__badge">Tienda oficial</span>
              <h2 class="store-card__name">{store.name}</h2>
              <p class="store-card__city">{store.city}</p>

              <dl class="store-card__details">
                <div class="store-card__row">
                  <dt>Dirección</dt>
                  <dd>{store.address}</dd>
                </div>
                <div class="store-card__row">
                  <dt>Teléfono</dt>
                  <dd>
                    <a href={`tel:${store.phoneRaw}`}>{store.phone}</a>
                  </dd>
                </div>
                <div class="store-card__row">
                  <dt>Horario</dt>
                  <dd>{store.hours}</dd>
                </div>
              </dl>

              <a class="btn btn--primary store-card__cta" href={whatsappLink(msg)} target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.29Z" />
                </svg>
                Escribir por WhatsApp
              </a>
            </article>
          );
        })
      }
    </div>

    <div class="stores__note">
      <h3>¿No encuentras lo que buscas?</h3>
      <p>
        Somos una tienda online con envíos a toda Colombia. Escríbenos por
        WhatsApp y con gusto te asesoramos o gestionamos tu pedido.
      </p>
      <a class="btn btn--secondary" href="/catalogo">Ver catálogo</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: var(--space-12) var(--space-8);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 70%);
  }

  .page-hero__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .page-hero__subtitle {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .stores {
    padding-block: var(--space-8) var(--space-16);
    display: grid;
    gap: var(--space-16);
  }

  .stores__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .store-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .store-card__badge {
    position: absolute;
    top: -1px;
    right: var(--space-6);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold-hover);
  }

  .store-card__name {
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .store-card__city {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-primary);
  }

  .store-card__details {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-2);
  }

  .store-card__row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
  }

  .store-card__row dt {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .store-card__row dd {
    color: var(--color-text);
  }

  .store-card__row a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .store-card__cta {
    margin-top: var(--space-2);
  }

  .stores__note {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 80%);
  }

  .stores__note h3 {
    font-size: var(--font-size-lg);
    font-weight: 800;
    color: var(--color-text);
  }

  .stores__note p {
    color: var(--color-text-muted);
    max-width: 60ch;
  }
</style>
