---
// Página de detalle de producto. Se renderiza en cada petición (SSR) y el
// producto se lee de la base de datos por su handle, de modo que los cambios
// del panel de administración se reflejan de forma inmediata.

import Layout from '../../layouts/Layout.astro';
import ProductBuyBox from '../../components/product/ProductBuyBox.tsx';
import ProductGallery from '../../components/product/ProductGallery.tsx';
import ProductReviews from '../../components/product/ProductReviews.tsx';
import ProductCard from '../../components/ProductCard.astro';
import { getProductByHandle, getProductReviews, getRelatedProducts } from '../../lib/medusa';
import '../../styles/product-gallery.css';

const { handle } = Astro.params;
const product = await getProductByHandle(handle ?? '');

if (!product) {
  return Astro.redirect('/catalogo');
}

const images = product.images.length > 0 ? product.images : (product.thumbnail ? [{ url: product.thumbnail }] : []);
const related = await getRelatedProducts(product, 4);
const reviews = await getProductReviews(product.id);
const reviewsAvg = reviews.length ? reviews.reduce((s, r) => s + r.calificacion, 0) / reviews.length : null;
---

<Layout title={`${product.title} — CilMax`}>
  <nav class="breadcrumb container" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/catalogo">Catálogo</a>
    {product.collectionTitle && (
      <>
        <span aria-hidden="true">/</span>
        <span>{product.collectionTitle}</span>
      </>
    )}
  </nav>

  <section class="product-detail container">
    <div class="product-detail__media">
      {
        images.length > 0 ? (
          <ProductGallery images={images} title={product.title} client:load />
        ) : (
          <div class="product-detail__placeholder" aria-hidden="true">
            <span>{product.title.slice(0, 1)}</span>
          </div>
        )
      }
    </div>

    <div class="product-detail__info">
      {product.collectionTitle && (
        <span class="product-detail__collection">{product.collectionTitle}</span>
      )}
      <h1 class="product-detail__title">{product.title}</h1>
      <p class="product-detail__description">{product.description}</p>

      <ProductBuyBox product={product} client:load />
    </div>
  </section>

  <section class="opiniones container">
    <ProductReviews
      productId={product.id}
      productTitle={product.title}
      reviews={reviews}
      avg={reviewsAvg}
      count={reviews.length}
      client:load
    />
  </section>

  {
    related.length > 0 && (
      <section class="related container">
        <h2 class="related__title">Productos relacionados</h2>
        <div class="related__grid">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )
  }
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-4) var(--space-16);
  }

  .product-detail__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-muted);
  }

  .product-detail__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-border);
  }

  .product-detail__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .product-detail__collection {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .product-detail__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .product-detail__description {
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .product-detail .buy-box {
    margin-top: var(--space-4);
  }

  .opiniones {
    padding-block: var(--space-2) var(--space-16);
  }

  .reviews {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .reviews__summary .reviews__score {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reviews__avg {
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .reviews__count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .stars {
    display: inline-flex;
    gap: 2px;
    line-height: 1;
  }

  .star {
    color: var(--color-accent);
    font-size: var(--stars-size);
  }

  .star--on {
    color: var(--color-gold);
  }

  .reviews__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .reviews__empty {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .review {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .review__name {
    font-weight: 700;
    color: var(--color-text);
  }

  .review__body {
    margin-top: var(--space-2);
    color: var(--color-text);
    line-height: 1.6;
  }

  .review__date {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .review-form {
    max-width: 560px;
  }

  .review-form__title {
    font-weight: 800;
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-3);
  }

  .review-form__stars {
    display: inline-flex;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .review-form__stars .star {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.6rem;
    color: var(--color-border);
    transition: color 0.15s;
  }

  .review-form__stars .star:hover,
  .review-form__stars .star--on {
    color: var(--color-gold);
  }

  .review-form__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .review-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .review-form__fields input,
  .review-form__fields textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font: inherit;
    font-size: var(--font-size-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .review-form__fields input:focus,
  .review-form__fields textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .review-form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .review-form__status {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .review-form__status--error {
    color: #b91c1c;
  }

  .review-form__done {
    color: var(--color-primary);
    font-weight: 600;
  }

  .review-form > .btn {
    margin-top: var(--space-3);
  }

  @media (max-width: 720px) {
    .review-form__row {
      grid-template-columns: 1fr;
    }
  }

  .related {
    padding-block: var(--space-4) var(--space-16);
  }

  .related__title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-4);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 900px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .product-detail {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
