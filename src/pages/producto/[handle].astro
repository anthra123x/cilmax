---
// Página de detalle de producto. Se renderiza en cada petición (SSR) y el
// producto se lee de la base de datos por su handle, de modo que los cambios
// del panel de administración se reflejan de forma inmediata.

import Layout from '../../layouts/Layout.astro';
import ProductBuyBox from '../../components/product/ProductBuyBox.tsx';
import ProductGallery from '../../components/product/ProductGallery.tsx';
import ProductReviews from '../../components/product/ProductReviews.tsx';
import ProductCard from '../../components/ProductCard.astro';
import { getProductByHandle, getProductReviews, getRelatedProducts } from '../../lib/medusa';
import '../../styles/product-gallery.css';

const { handle } = Astro.params;
const product = await getProductByHandle(handle ?? '');

if (!product) {
  return Astro.redirect('/catalogo');
}

const images = product.images.length > 0 ? product.images : (product.thumbnail ? [{ url: product.thumbnail }] : []);
const related = await getRelatedProducts(product, 4);
const reviews = await getProductReviews(product.id);
const reviewsAvg = reviews.length ? reviews.reduce((s, r) => s + r.calificacion, 0) / reviews.length : null;
---

<Layout title={`${product.title} — CilMax`}>
  <nav class="breadcrumb container" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/catalogo">Catálogo</a>
    {product.collectionTitle && (
      <>
        <span aria-hidden="true">/</span>
        <span>{product.collectionTitle}</span>
      </>
    )}
  </nav>

  <section class="product-detail container">
    <div class="product-detail__media">
      {
        images.length > 0 ? (
          <ProductGallery images={images} title={product.title} client:load />
        ) : (
          <div class="product-detail__placeholder" aria-hidden="true">
            <span>{product.title.slice(0, 1)}</span>
          </div>
        )
      }
    </div>

    <div class="product-detail__info">
      {product.collectionTitle && (
        <span class="product-detail__collection">{product.collectionTitle}</span>
      )}
      <h1 class="product-detail__title">{product.title}</h1>
      <p class="product-detail__description">{product.description}</p>

      <ProductBuyBox product={product} client:load />
    </div>
  </section>

  <section class="opiniones container">
    <ProductReviews
      productId={product.id}
      productTitle={product.title}
      reviews={reviews}
      avg={reviewsAvg}
      count={reviews.length}
      client:load
    />
  </section>

  {
    related.length > 0 && (
      <section class="related container">
        <h2 class="related__title">Productos relacionados</h2>
        <div class="related__grid">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )
  }
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-4) var(--space-16);
  }

  .product-detail__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-muted);
  }

  .product-detail__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-border);
  }

  .product-detail__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .product-detail__collection {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .product-detail__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .product-detail__description {
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .product-detail .buy-box {
    margin-top: var(--space-4);
  }

  .opiniones {
    padding-block: var(--space-2) var(--space-16);
  }

  .reviews {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-6);
  }

  .reviews__title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  /* ---- Resumen (promedio + histograma) ---- */
  .reviews__summary {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .reviews__score {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 140px;
  }

  .reviews__avg {
    font-size: var(--font-size-4xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
  }

  .reviews__count {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .stars {
    display: inline-flex;
    gap: 2px;
    line-height: 1;
  }

  .star {
    color: var(--color-border);
    font-size: var(--stars-size);
  }

  .star--on {
    color: var(--color-gold);
  }

  .histogram {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .histogram__row {
    display: grid;
    grid-template-columns: 24px 1fr 28px;
    align-items: center;
    gap: var(--space-2);
  }

  .histogram__label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-gold);
    text-align: center;
  }

  .histogram__track {
    height: 8px;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-muted);
    overflow: hidden;
  }

  .histogram__fill {
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-gold-hover), var(--color-gold));
    transition: width 0.4s ease;
  }

  .histogram__count {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: right;
  }

  .reviews__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .reviews__empty {
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  /* ---- Card de reseña ---- */
  .review {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .review:hover {
    box-shadow: var(--shadow-sm);
    border-color: color-mix(in srgb, var(--color-primary) 30%, var(--color-border));
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .review__avatar {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--font-size-lg);
  }

  .review__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .review__name {
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .review__date {
    margin-left: auto;
    flex-shrink: 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .review__body {
    margin-top: var(--space-3);
    color: var(--color-text);
    line-height: 1.6;
    font-size: var(--font-size-sm);
  }

  /* ---- Formulario (card espejo de contacto) ---- */
  .review-form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .review-form__title {
    font-weight: 800;
    font-size: var(--font-size-xl);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .review-form__stars {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .review-form__stars .star {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-border);
    transition: color 0.15s, transform 0.1s ease;
  }

  .review-form__stars .star:hover,
  .review-form__stars .star--on {
    color: var(--color-gold);
  }

  .review-form__stars .star:hover {
    transform: scale(1.12);
  }

  .review-form__stars-label {
    margin-left: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .review-form__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .review-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field__label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .field__input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--font-size-base);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .field__textarea {
    resize: vertical;
  }

  .review-form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .review-form__status {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .review-form__status--error {
    color: var(--color-danger);
  }

  .review-form > .btn {
    justify-self: start;
    margin-top: var(--space-2);
  }

  .review-form__done-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .review-form__done {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .reviews__summary {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .reviews__score {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      min-width: 0;
    }

    .review-form__row {
      grid-template-columns: 1fr;
    }
  }

  .related {
    padding-block: var(--space-4) var(--space-16);
  }

  .related__title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-4);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 900px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .product-detail {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
