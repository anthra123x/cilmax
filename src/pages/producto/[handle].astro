---
// Página de detalle de producto. Se renderiza en cada petición (SSR) y el
// producto se lee de la base de datos por su handle, de modo que los cambios
// del panel de administración se reflejan de forma inmediata.

import Layout from '../../layouts/Layout.astro';
import ProductBuyBox from '../../components/product/ProductBuyBox.tsx';
import ProductGallery from '../../components/product/ProductGallery.tsx';
import ProductReviews from '../../components/product/ProductReviews.tsx';
import ProductCard from '../../components/ProductCard.astro';
import { getProductByHandle, getProductReviews, getRelatedProducts } from '../../lib/medusa';
import '../../styles/product-gallery.css';

const { handle } = Astro.params;
const product = await getProductByHandle(handle ?? '');

if (!product) {
  return Astro.redirect('/catalogo');
}

const images = product.images.length > 0 ? product.images : (product.thumbnail ? [{ url: product.thumbnail }] : []);
const related = await getRelatedProducts(product, 4);
const reviews = await getProductReviews(product.id);
const reviewsAvg = reviews.length ? reviews.reduce((s, r) => s + r.calificacion, 0) / reviews.length : null;
---

<Layout title={`${product.title} — CilMax`}>
  <nav class="breadcrumb container" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/catalogo">Catálogo</a>
    {product.collectionTitle && (
      <>
        <span aria-hidden="true">/</span>
        <span>{product.collectionTitle}</span>
      </>
    )}
  </nav>

  <section class="product-detail container">
    <div class="product-detail__media">
      {
        images.length > 0 ? (
          <ProductGallery images={images} title={product.title} client:load />
        ) : (
          <div class="product-detail__placeholder" aria-hidden="true">
            <span>{product.title.slice(0, 1)}</span>
          </div>
        )
      }
    </div>

    <div class="product-detail__info">
      {product.collectionTitle && (
        <span class="product-detail__collection">{product.collectionTitle}</span>
      )}
      <h1 class="product-detail__title">{product.title}</h1>
      <p class="product-detail__description">{product.description}</p>

      <ProductBuyBox product={product} client:load />
    </div>
  </section>

  <section class="opiniones container">
    <ProductReviews
      productId={product.id}
      reviews={reviews}
      avg={reviewsAvg}
      count={reviews.length}
      client:load
    />
  </section>

  {
    related.length > 0 && (
      <section class="related container">
        <h2 class="related__title rise-in">Productos relacionados</h2>
        <div class="related__grid">
          {related.map((p, i) => (
            <div class="related__cell" data-reveal style={`--i: ${i}`}>
              <ProductCard product={p} />
            </div>
          ))}
        </div>
      </section>
    )
  }
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    position: relative;
  }

  .breadcrumb a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out-quart);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb a:hover::after {
    transform: scaleX(1);
  }

  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-4) var(--space-16);
  }

  .product-detail__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-muted);
  }

  .product-detail__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-border);
  }

  .product-detail__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .product-detail__collection {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .product-detail__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .product-detail__description {
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .product-detail .buy-box {
    margin-top: var(--space-4);
  }

  .related {
    padding-block: var(--space-4) var(--space-16);
  }

  .related__title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-4);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 900px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .product-detail {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
