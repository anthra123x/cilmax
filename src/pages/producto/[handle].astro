---
// Página de detalle de producto. Se prerenderiza una página estática por
// cada producto (getStaticPaths) con datos de Medusa o fallback local.
// Con `revalidate` se habilita ISR en Vercel.

import Layout from '../../layouts/Layout.astro';
import ProductBuyBox from '../../components/product/ProductBuyBox.tsx';
import { getProducts } from '../../lib/medusa';

export const prerender = true;
export const revalidate = 300;

export async function getStaticPaths() {
  const products = await getProducts(100);
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

const { product } = Astro.props;
const image = product.images[0]?.url ?? product.thumbnail;
---

<Layout title={`${product.title} — CilMax`}>
  <nav class="breadcrumb container" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/catalogo">Catálogo</a>
    {product.collectionTitle && (
      <>
        <span aria-hidden="true">/</span>
        <span>{product.collectionTitle}</span>
      </>
    )}
  </nav>

  <section class="product-detail container">
    <div class="product-detail__media">
      {
        image ? (
          <img src={image} alt={product.title} fetchpriority="high" />
        ) : (
          <div class="product-detail__placeholder" aria-hidden="true">
            <span>{product.title.slice(0, 1)}</span>
          </div>
        )
      }
    </div>

    <div class="product-detail__info">
      {product.collectionTitle && (
        <span class="product-detail__collection">{product.collectionTitle}</span>
      )}
      <h1 class="product-detail__title">{product.title}</h1>
      <p class="product-detail__description">{product.description}</p>

      <ProductBuyBox product={product} client:load />
    </div>
  </section>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-4) var(--space-16);
  }

  .product-detail__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-muted);
  }

  .product-detail__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-detail__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-border);
  }

  .product-detail__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .product-detail__collection {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .product-detail__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .product-detail__description {
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .product-detail .buy-box {
    margin-top: var(--space-4);
  }

  @media (max-width: 820px) {
    .product-detail {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
