---
// Página "Ofertas" del catálogo. Muestra los productos seleccionados como
// ofertas. Como los descuentos se gestionan por WhatsApp, se incluye un
// banner que aclara cómo consultar los precios promocionales.

import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts } from '../../lib/medusa';
import { whatsappLink } from '../../lib/site';

export const prerender = true;
export const revalidate = 300;

const all = await getProducts(24);
const products = all.filter((p) => p.featured).length ? all.filter((p) => p.featured) : all;
---

<Layout
  title="Ofertas — CilMax"
  description="Ofertas y precios especiales en CilMax. Consulta descuentos vigentes por WhatsApp."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Ofertas</h1>
      <p class="page-hero__subtitle">
        Precios especiales y productos seleccionados. Escríbenos por WhatsApp
        para confirmar el descuento vigente de tu favorito.
      </p>
    </div>
  </section>

  <section class="offers container">
    <div class="offers__banner">
      <div>
        <h2>¿Quieres un mejor precio?</h2>
        <p>
          Consulta por WhatsApp las ofertas y descuentos vigentes. Te
          confirmamos precios promocionales y disponibilidad al momento.
        </p>
      </div>
      <a class="btn btn--primary" href={whatsappLink('Hola CilMax, quiero cotizar un producto.')} target="_blank" rel="noopener">
        Cotizar por WhatsApp
      </a>
    </div>

    <div class="catalog__header">
      <h2>{products.length} productos en oferta</h2>
    </div>

    {
      products.length > 0 ? (
        <div class="catalog__grid">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <p class="catalog__empty">No hay ofertas disponibles por ahora.</p>
      )
    }
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: var(--space-12) var(--space-8);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 70%);
  }

  .page-hero__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .page-hero__subtitle {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .offers {
    padding-block: var(--space-8) var(--space-16);
    display: grid;
    gap: var(--space-8);
  }

  .offers__banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg) 80%);
  }

  .offers__banner h2 {
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .offers__banner p {
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .catalog__header {
    margin-bottom: var(--space-2);
  }

  .catalog__header h2 {
    font-size: var(--font-size-xl);
    font-weight: 700;
  }

  .catalog__empty {
    color: var(--color-text-muted);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 1024px) {
    .catalog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .catalog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
